{
  "expo": {
    "name": "Chaos Coordinated QA",
    "slug": "chaos-coordinated-ios-qa",
    "scheme": "chaoscoordinatedqa",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07131C",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chaos Coordinated QA checks your location only when you perform a testing action requiring location verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chaos Coordinated QA accesses only photos or videos you choose for test work evidence.",
          "cameraPermission": "Chaos Coordinated QA uses the camera when you capture test work evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#32D4B3",
          "defaultChannelName": "QA Assignments"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitaldivide.chaoscoordinated.qa",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.digitaldivide.chaoscoordinated.qa",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
